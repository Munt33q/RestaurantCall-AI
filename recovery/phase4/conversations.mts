// Synthetic text -> real interpretation/checkout/controller. No database, phone,
// model credential, payment or message delivery. Timings are local, not PSTN.
import assert from 'node:assert/strict';import {writeFileSync} from 'node:fs';
import {understandVoiceTurn} from '../../frontend/lib/ai-menu';import {decideTurn,initialState,type CartState} from '../../frontend/lib/voice-engine';import {gateRelayCheckout} from '../../frontend/lib/relay/checkout';import {RelayController} from '../../frontend/lib/relay/controller';import {voiceCopy} from '../../frontend/lib/voice-copy';
const menu=[{id:'b',name:'Classic Burger',aliases:['برگر','برجر','बर्गर','hamburguesa'],itemNumber:1,priceCents:1000,isAvailable:true,stockQty:10},{id:'f',name:'Crispy Fries',aliases:['فرائز','بطاطا','फ्राइज','papas'],itemNumber:2,priceCents:250,isAvailable:true,stockQty:10}];
Object.assign(process.env,{NODE_ENV:'test',AI_FALLBACK_ENABLED:'false'});for(const key of Object.keys(process.env))if(/^(AI_(?!FALLBACK_ENABLED)|ACCEPTANCE_|DEEPSEEK_|DATABASE_URL|DIRECT_DATABASE_URL|TELNYX_|STRIPE_|XI_)/.test(key))delete process.env[key];
const cases=[['en','two Classic Burger and one Crispy Fries','done','yes','cash','none','no notes','place it'],['es','dos hamburguesa y una papas','eso es todo','sí','efectivo','no','sin notas','es correcto'],['ar','اثنان برجر و واحد بطاطا','انتهيت','نعم','نقداً','لا','لا ملاحظات','نفذ الطلب'],['ur','دو برگر اور ایک فرائز','یہ سب ہے','جی ہاں','نقد','نہیں','کوئی ہدایت نہیں','آرڈر درج کریں'],['hi','दो बर्गर और एक फ्राइज','बस इतना ही','हाँ','नकद','नहीं','कोई नोट नहीं','कर दीजिए']] as const;
const scenarios=[];
for(const [language,add,done,yes,cash,no,notes,confirm] of cases){
 let state:CartState={...initialState(),languagePreference:{language,confirmed:true,revision:1}},turn=0,delivery=0,simulatedCommits=0;const transcript:any[]=[],timings:number[]=[],rejections:string[]=[];let understood:any,reply:any;
 const c=new RelayController({send:(message:any)=>{if(message.type==='text')transcript.push({role:'assistant',text:message.token});},diagnostic:r=>rejections.push(r),prepare:async speech=>{understood=await understandVoiceTurn(speech,menu,{...state,history:[]});return {speech,turn};},commit:async prepared=>{const result=gateRelayCheckout(decideTurn(state,understood.speech,menu,825,understood.extracted,understood.operation,undefined,understood),state.relayReviewReady===true,menu,825);if(result.checkoutRejection)rejections.push(result.checkoutRejection);if(result.submit){simulatedCommits++;result.reply=voiceCopy(language,'cashReceipt','SYNTHETIC-001');result.state.orderReceipt=result.reply;}state=result.state;state.relayReviewReady=false;reply={reply:result.reply,turn:++turn,deliveryId:String(++delivery),phase:state.phase,requiresReadback:result.reviewRequired,finished:result.submit};return reply;},ack:async(id,played)=>{assert.equal(id,reply.deliveryId);assert.equal(played,reply.reply);if(reply.requiresReadback)state.relayReviewReady=true;},interrupt:async()=>{state.relayReviewReady=false;}});
 async function say(speech:string){transcript.push({role:'caller',text:speech});const start=performance.now();await c.handle({type:'prompt',voicePrompt:speech,last:true});timings.push(Number((performance.now()-start).toFixed(3)));}
 for(const speech of [add,done,'Alex',yes,cash,no,notes])await say(speech);
 assert.equal(reply.requiresReadback,true);assert.match(reply.reply,/\$24\.35/);
 // Reproduce a blocked early confirmation, then delayed tokens and the SAME final.
 await say(confirm);assert.equal(simulatedCommits,0);await c.handle({type:'info',name:'agentSpeaking',value:'off'});await c.handle({type:'info',name:'tokensPlayed',value:reply.reply});
 await Promise.all([say(confirm),c.handle({type:'prompt',voicePrompt:confirm,last:true})]);assert.equal(simulatedCommits,1);assert.equal(state.phase,'complete');assert.equal(transcript.some(t=>/let me check that for you/i.test(t.text)),false);c.close();
 scenarios.push({language,transcript,localTurnMs:timings,simulatedOrderCommits:simulatedCommits,rejections});
}
const sorted=scenarios.flatMap(s=>s.localTurnMs).sort((a,b)=>a-b);
writeFileSync('../docs/phase4/evidence/conversations.json',JSON.stringify({source:'synthetic text/relay simulation',actualSTT:false,actualTTS:false,actualModel:false,actualPSTN:false,productionWrites:false,latencyScope:'in-process deterministic turns; excludes network, database, model, recognition and synthesis',medianMs:sorted[Math.floor(sorted.length/2)],maxMs:sorted.at(-1),scenarios},null,2)+'\n');
console.log('PASS five synthetic multilingual conversations; exactly one simulated commit each; no filler.');
