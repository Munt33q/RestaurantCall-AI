 const event={id:'evt_fixture_'+crypto.randomUUID(),type:'checkout.session.completed',livemode:false,data:{object:{...checkout,payment_status:'paid'}}};const body=JSON.stringify(event);const signature=stripe.webhooks.generateTestHeaderString({payload:body,secret});
