[
  {
    "name": "search_menu",
    "description": "Search the live restaurant menu. Use for prices, availability and ingredient questions. Clarify which match the customer wants before modifying cart.",
    "method": "POST",
    "url": "https://APPROVED_APP_HOST/api/elevenlabs/tools",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer <SECRET_FROM_ELEVENLABS_SECRETS>",
      "x-restaurant-session": "{{secret__restaurant_session}}"
    },
    "body_fixed": {
      "tool": "search_menu"
    },
    "body_dynamic": {
      "conversation_id": "{{system__conversation_id}}"
    },
    "body_llm_fields": {
      "query": {
        "type": "string",
        "description": "Customer search text",
        "required": false
      }
    },
    "status": "prepared_requires_provider_acceptance_and_launch_approval"
  },
  {
    "name": "update_cart",
    "description": "Add, set quantity or remove a selected menu item by its ID. Always search menu first and use a returned ID.",
    "method": "POST",
    "url": "https://APPROVED_APP_HOST/api/elevenlabs/tools",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer <SECRET_FROM_ELEVENLABS_SECRETS>",
      "x-restaurant-session": "{{secret__restaurant_session}}"
    },
    "body_fixed": {
      "tool": "update_cart"
    },
    "body_dynamic": {
      "conversation_id": "{{system__conversation_id}}"
    },
    "body_llm_fields": {
      "item_id": {
        "type": "string",
        "description": "Exact menu UUID returned by search_menu",
        "required": true
      },
      "operation": {
        "type": "string",
        "description": "One of add, set, remove",
        "required": true
      },
      "quantity": {
        "type": "integer",
        "description": "Number of items, 1–20 except for remove",
        "required": false
      }
    },
    "status": "prepared_requires_provider_acceptance_and_launch_approval"
  },
