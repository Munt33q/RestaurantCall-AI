  {
    "name": "set_customer_details",
    "description": "Collect the pickup name. The backend uses the provider-verified caller number; a different callback number is rejected. The customer confirms their name on the independent final review page.",
    "method": "POST",
    "url": "https://APPROVED_APP_HOST/api/elevenlabs/tools",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer <SECRET_FROM_ELEVENLABS_SECRETS>",
      "x-restaurant-session": "{{secret__restaurant_session}}"
    },
    "body_fixed": {
      "tool": "set_customer_details"
    },
    "body_dynamic": {
      "conversation_id": "{{system__conversation_id}}"
    },
    "body_llm_fields": {
      "customer_name": {
        "type": "string",
        "description": "Customer pickup name",
        "required": true
      },
      "customer_phone": {
        "type": "string",
        "description": "Optional; must exactly equal the provider-verified caller. Never invent a number.",
        "required": false
      },
      "name_confirmed": {
        "type": "boolean",
        "description": "True only if name confirmed verbally",
        "required": false
      }
    },
    "status": "prepared_requires_provider_acceptance_and_launch_approval"
  },
