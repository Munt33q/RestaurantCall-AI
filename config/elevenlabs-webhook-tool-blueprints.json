    },
    "body_fixed": {
      "tool": "set_notification_preference"
    },
    "body_dynamic": {
      "conversation_id": "{{system__conversation_id}}"
    },
    "body_llm_fields": {
      "channel": {
        "type": "string",
        "description": "none, sms, or call",
        "required": true
      },
      "consent": {
        "type": "boolean",
        "description": "True only after explicit customer opt-in",
        "required": true
      }
    },
    "status": "preview_only"
  },
