    "url": "https://YOUR_VERIFIED_PREVIEW_DOMAIN/api/elevenlabs/tools",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer <SECRET_FROM_ELEVENLABS_SECRETS>"
    },
    "body_fixed": {
      "tool": "get_cart"
    },
    "body_dynamic": {
      "conversation_id": "{{system__conversation_id}}"
    },
    "body_llm_fields": {},
    "status": "preview_only"
  },
  {
    "name": "set_customer_details",
    "description": "Record the pickup name and an explicitly confirmed callback number.",
    "method": "POST",
    "url": "https://YOUR_VERIFIED_PREVIEW_DOMAIN/api/elevenlabs/tools",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer <SECRET_FROM_ELEVENLABS_SECRETS>"
    },
    "body_fixed": {
      "tool": "set_customer_details"
    },
    "body_dynamic": {
      "conversation_id": "{{system__conversation_id}}"
    },
    "body_llm_fields": {
      "customer_name": {
        "type": "string",
        "description": "Customer pickup name",
        "required": true
      },
      "customer_phone": {
        "type": "string",
        "description": "Callback phone in E.164 format, only if confirmed by customer",
        "required": false
      },
      "name_confirmed": {
        "type": "boolean",
        "description": "True only if name confirmed verbally",
        "required": false
      }
    },
    "status": "preview_only"
  },
  {
    "name": "set_notification_preference",
    "description": "Record provisional explicit notification preference. Does not activate sending.",
    "method": "POST",
    "url": "https://YOUR_VERIFIED_PREVIEW_DOMAIN/api/elevenlabs/tools",
