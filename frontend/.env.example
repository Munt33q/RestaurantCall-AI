# Explicit bella selects historical hpp4J3VqNfWAUOO0d1Us for rollback.
LANGUAGE_PREFERENCE_ENABLED=false
# JSON array of verified per-language voice/STT profiles, with evidenceRef.
# Empty until real recognition, synthesis and relay switching are accepted.
VOICE_LANGUAGE_PROFILES_JSON=[]

# Phase 5 ElevenLabs preview adapter. Keep disabled until an active call is
# bound through the authenticated session endpoint and provider acceptance is complete.
ELEVENLABS_WEBHOOKS_ENABLED=false
ELEVENLABS_TOOL_API_KEY=
ELEVENLABS_SESSION_BINDING_ENABLED=false
